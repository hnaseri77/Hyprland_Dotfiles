# Set Default Environment
export TERMINAL=kitty
export EDITOR=nvim
export VISUAL=nvim
export BROWSER=brave-browser
export FILEMANAGER=dolphin
export FILE_MANAGER=dolphin



# Cursor
export XCURSOR_THEME=Bibata-Modern-Classic
